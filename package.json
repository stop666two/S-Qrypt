{
  "name": "s-qrypt",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit",
    "deploy": "tsc --noEmit && node scripts/obfuscate.mjs && npm run db:migrations:apply && wrangler deploy",
