    "db:migrations:apply": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.4",
    "@types/node": "^26.1.1",
    "typescript": "^5.9.3",
    "vitest": "~3.2.0",
    "wrangler": "^4.82.2"
  }
}
